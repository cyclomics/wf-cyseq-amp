nextflow_function {

    name "Test report path helper functions"
    script "modules/report.nf"

    // reportsDir
    test("reportsDir returns correct base path") {
        tag "report_functions_1"
        tag "unit-test"
        function "reportsDir"

        when {
            params {
                output_dir = "/data/output"
            }
            function {
                """
                input[0] = "sample_1"
                """
            }
        }

        then {
            assert function.result == "/data/output/sample_1/report"
        }
    }

    // onTargetRateYml
    test("onTargetRateYml returns correct path under depth/") {
        tag "report_functions_2"
        tag "unit-test"
        function "onTargetRateYml"

        when {
            params {
                output_dir = "/data/output"
            }
            function  { 
                """
                input[0] = "sample_1"
                """
            }
        }

        then {
            assert function.result.toString() == "/data/output/sample_1/report/depth/on_target_rate_live.yml"
        }
    }

    // ampDepthYml
    test("ampDepthYml returns correct path under depth/") {
        tag "report_functions_3"
        tag "unit-test"
        function "ampDepthYml"

        when {
            params {
                output_dir = "/data/output"
            }
            function {
                """
                input[0] = "sample_1"
                """
            }
        }

        then {
            assert function.result.toString() == "/data/output/sample_1/report/depth/amplicon_depth_live.yml"
        }
    }

    // Consistency: onTargetRateYml and ampDepthYml share the same base
    test("onTargetRateYml and ampDepthYml share the same reportsDir base") {
        tag "report_functions_4"
        tag "unit-test"
        function "reportsDir"

        when {
            params {
                output_dir = "/data/output"
            }
            function {
                """
                input[0] = "sample_1"
                """
            }
        }

        then {
            def base = function.result
            assert "/data/output/sample_1/report/depth/on_target_rate_live.yml".startsWith(base)
            assert "/data/output/sample_1/report/depth/amplicon_depth_live.yml".startsWith(base)
        }
    }
}

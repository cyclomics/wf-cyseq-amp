nextflow_process {

    name "Test StreamOnTargetRate"
    script "modules/report.nf"
    process "StreamOnTargetRate"

    test("First file, no prior accumulation") {
        tag "unit-test"

        when {
            process {
                """
                input[0] = Channel.of([
                    "sample_1",
                    "file_1",
                    file("${projectDir}/tests/fixtures/report/depth/on_target_rate.yml"),
                    file("on_target_rate_live.yml")
                ])
                """
            }
        }

        then {
            assert process.success

            def yml = path(process.out[0][0][2]).yaml
            assert yml.total_reads == 1000
            assert yml.on_target_reads == 900
            assert yml.off_target_reads == 100
            assert yml.cards.on_target_rate == 90.0
        }
    }

    test("Second file, accumulates counts and recalculates rate") {
        tag "unit-test"

        when {
            process {
                """
                input[0] = Channel.of([
                    "sample_1",
                    "file_2",
                    file("${projectDir}/tests/fixtures/report/depth/on_target_rate.yml"),
                    file("${projectDir}/tests/fixtures/report/depth/on_target_rate_live.yml")
                ])
                """
            }
        }

        then {
            assert process.success

            def yml = path(process.out[0][0][2]).yaml
            // on_target_rate.yml: 1000 total, 900 on, 100 off
            // on_target_rate_live.yml: 181165 total, 173562 on, 7603 off
            // Accumulated: 182165 total, 174462 on, 7703 off
            assert yml.total_reads == 182165
            assert yml.on_target_reads == 174462
            assert yml.off_target_reads == 7703

            // Recalculated rate: 174462 / 182165 * 100 ≈ 95.8
            assert yml.cards.on_target_rate >= 95.0
            assert yml.cards.on_target_rate <= 96.0
        }
    }

    test("Handles zero total reads gracefully") {
        tag "unit-test"

        when {
            process {
                """
                def zeroMetrics = file("${workDir}/zero_metrics.yml")
                zeroMetrics.text = '''total_reads: 0
on_target_reads: 0
off_target_reads: 0
cards:
  on_target_rate: 0.0
'''
                input[0] = Channel.of([
                    "sample_1",
                    "file_1",
                    zeroMetrics,
                    file("on_target_rate_live.yml")
                ])
                """
            }
        }

        then {
            assert process.success

            def yml = path(process.out[0][0][2]).yaml
            assert yml.total_reads == 0
            assert yml.on_target_reads == 0
            assert yml.off_target_reads == 0
            assert yml.cards.on_target_rate == 0.0
        }
    }
}

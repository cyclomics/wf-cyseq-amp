nextflow_process {

    name "Test UpdateRunningReads"
    script "modules/report.nf"
    process "UpdateRunningReads"

    // First run, no prior published file
    test("First file, no prior accumulation") {
        tag "unit-test"

        when {
            process {
                """
                input[0] = Channel.of([
                    "sample_1",
                    "file_1",
                    file("${projectDir}/tests/fixtures/reads_raw.json"),
                    file("number_of_reads_running.yml")
                ])
                """
            }
        }

        then {
            assert process.success

            // Output tuple shape
            with(process.out[0][0]) {
                assert get(0) == "sample_1"
                assert get(1) == "file_1"
            }

            // Output YML exists and has correct structure
            def yml = path(process.out[0][0][2]).yaml
            assert yml.name == "Raw reads"
            assert yml.data.x == ["raw"]
            assert yml.data.y == [4000]
            assert yml.layout.title == "Number of raw reads"
        }
    }

    // Second file, accumulates on top of prior run
    test("Second file, accumulates on prior published YML") {
        tag "unit-test"

        when {
            process {
                """
                input[0] = Channel.of([
                    "sample_1",
                    "file_2",
                    file("${projectDir}/tests/fixtures/reads_raw_2.json"),
                    file("${projectDir}/tests/fixtures/number_of_reads_running.yml")
                ])
                """
            }
        }

        then {
            assert process.success

            def yml = path(process.out[0][0][2]).yaml
            assert yml.data.x == ["raw"]
            // 4000 (prior) + 5000 (new) = 9000
            assert yml.data.y == [9000]
        }
    }

    // Zero reads in new file
    test("Zero reads in input JSON") {

        when {
            process {
                """
                def zeroJson = file("${workDir}/zero_reads.json")
                zeroJson.text = '{"type": "raw", "reads": 0}'

                input[0] = Channel.of([
                    "sample_1",
                    "file_1",
                    zeroJson,
                    file("number_of_reads_running.yml")
                ])
                """
            }
        }

        then {
            assert process.success

            def yml = path(process.out[0][0][2]).yaml
            assert yml.data.y == [0]
        }
    }

    // Multiple samples accumulate independently
    test("Two different sample_ids produce separate outputs") {
        tag "unit-test"

        when {
            process {
                """
                input[0] = Channel.of(
                    [
                        "sample_1", "file_1",
                        file("${projectDir}/tests/fixtures/reads_raw.json"),
                        file("number_of_reads_running.yml")
                    ],
                    [
                        "sample_2", "file_1",
                        file("${projectDir}/tests/fixtures/reads_raw_2.json"),
                        file("number_of_reads_running.yml")
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 2

            def result = process.out[0]
            assert result[0][0] == "sample_1"
            assert result[1][0] == "sample_2"

            def ymls = process.out[0].collect { path(it[2]).yaml }
            def xs = ymls.collectMany { it.data.x }
            assert xs[0] == "raw"
            assert xs[1] == "raw"
        }
    }
}


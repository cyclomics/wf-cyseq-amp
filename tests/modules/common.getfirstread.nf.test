nextflow_process {

    name "Test Process getFirstRead"
    script "modules/common.nf"
    process "getFirstRead"

    test("Extract the first read from fastq file") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = Channel.fromPath("${projectDir}/data/dummy.fastq")
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0]).readLines().contains('TheNameOfThisFirstRead')
            //assert snapshot(process.out).match()
            
        }

    }

}

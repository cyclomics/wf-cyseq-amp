nextflow_workflow {

    name "Test workflow: get_amplicon_metrics"
    script "modules/alignment.nf"
    workflow "get_amplicon_metrics"

    test("Aligns consensus reads and computes on-target metrics") {
        tag "workflow"
        tag "unit-test"

        when {
            workflow {
                """
                ch_consensus_reads = Channel.of([
                    "sample_1",
                    "file_1",
                    file("${projectDir}/tests/data/simple/dummy.fastq")
                ])
                ch_regions = Channel.of(file("${projectDir}/tests/fixtures/small.bed"))

                input[0] = ch_consensus_reads
                input[1] = ch_regions
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.aligned_consensus_bam.size() == 1
            assert workflow.out.depth_table.size() == 1
            assert workflow.out.on_target_rate.size() == 1

            assert workflow.out.aligned_consensus_bam[0][0] == "sample_1"
            assert workflow.out.aligned_consensus_bam[0][1] == "file_1"
            assert path(workflow.out.aligned_consensus_bam[0][2]).fileName.toString().endsWith(".bam")

            assert workflow.out.depth_table[0][0] == "sample_1"
            assert workflow.out.depth_table[0][1] == "file_1"
            assert path(workflow.out.depth_table[0][2]).fileName.toString().endsWith("_amplicon_depth.yml")

            assert workflow.out.on_target_rate[0][0] == "sample_1"
            assert workflow.out.on_target_rate[0][1] == "file_1"
            assert path(workflow.out.on_target_rate[0][2]).fileName.toString().endsWith("_on_target_rate.yml")
        }
    }

}

nextflow_process {

    name "Test Process MergeBamFiles"
    script "modules/alignment.nf"
    process "MergeBamFiles"

    test("Merges multiple BAM files into one") {
        tag "unit-test"

        when {
            process {
                """
                // Copy the source BAM to two unique files to avoid input filename collisions
                def bam1 = file("${projectDir}/tests/data/lambda/lambda_mut.bam")
                def bam2 = file("${projectDir}/tests/data/lambda/lambda_mut_copy.bam")

                input[0] = Channel.of([
                    "sample_1",
                    ["file_1", "file_2"],
                    [ bam1, bam2 ]
                ])
                """
            }
        }

        then {
            assert process.success

            // Output is a tuple [sample_id, sample_id, merged.bam, merged.bam.bai]
            assert process.out[0][0][0] == "sample_1"
            assert process.out[0][0][1] == "sample_1"
            assert path(process.out[0][0][2]).fileName.toString() == "sample_1.merged.bam"
            assert path(process.out[0][0][3]).fileName.toString() == "sample_1.merged.bam.bai"

            // Merged BAM and BAI should be non-empty
            assert path(process.out[0][0][2]).size() > 0
            assert path(process.out[0][0][3]).size() > 0
        }
    }

    test("Handles single BAM file input") {
        tag "unit-test"

        when {
            process {
                """
                input[0] = Channel.of([
                    "sample_1",
                    ["file_1"],
                    [file("${projectDir}/tests/data/lambda/lambda_mut.bam")]
                ])
                """
            }
        }

        then {
            assert process.success

            assert path(process.out[0][0][2]).fileName.toString() == "sample_1.merged.bam"
            assert path(process.out[0][0][2]).size() > 0
        }
    }
}

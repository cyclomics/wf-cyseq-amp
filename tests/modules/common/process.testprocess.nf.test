nextflow_process {

    name "Test Process TestProcess"
    script "modules/common.nf"
    process "TestProcess"
    
    test("Error on non existent reference") {
        tag "unit-test"
        when {
            params {}
            process {
                """
                input[0] = file("${projectDir}/tests/data/this_file_does_ont_exist.fasta")
                """
            }
        }
        then {
            assert process.failed
            assert snapshot(process.out).match()
        }
    }

    test("Should pass through reference genome") {
        tag "unit-test"
        when {
            params {}
            process {
                """
                input[0] = file("${projectDir}/tests/data/simple/tiny_ref.fasta")
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
            assert process.out[0].size() == 1
            assert process.out[0].get(0) == '>chr1\n'
        }
    }
}

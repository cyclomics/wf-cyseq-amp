nextflow_process {

    name "Test Process GetFirstRead"
    script "modules/common.nf"
    process "GetFirstRead"

    test("Extract the first read from fastq file") {
        tag "unit-test"
        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = file("${projectDir}/tests/data/simple/dummy.fastq")
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0]).readLines().size() == 4
            assert path(process.out[0][0]).readLines()[0] == '@TheNameOfThisFirstRead'
            assert path(process.out[0][0]).readLines()[1] == 'GTGTTTGGGAGTGAGTTTGC'
            assert path(process.out[0][0]).readLines()[2] == '+'
            assert path(process.out[0][0]).readLines()[3] == 'GGGGGGGGGGGGGGGGGGGG'
            assert snapshot(process.out).match() 
        }
    }
}

nextflow_process {

    name "Test AnnotateVariants"
    script "modules/variantcalling.nf"
    process "AnnotateVariants"
    config "tests/nextflow.config"

    test("Annotated VCF contains expected annotations") {
        tag "annotatevariants"
        tag "unit-test"
        
        when {
            process {
                """
                input[0] = Channel.of([
                    "sample_1",
                    "file_1",
                    file("${projectDir}/tests/fixtures/variants.vcf")
                ])
                """
            }
        }

        then {
            assert process.success

            def annotated_vcf = path(process.out[0][0][2])
            assert annotated_vcf.exists()

            def vcf_content = annotated_vcf.text
            assert vcf_content.contains("variant_class=")
            assert vcf_content.contains("consequence=")
            assert vcf_content.contains("cosmic=")
            assert vcf_content.contains("cosmic_legacy=")
            assert vcf_content.contains("gene=")
            assert vcf_content.contains("hgvsc=")
            assert vcf_content.contains("hgvsp=")
        }
    }
}
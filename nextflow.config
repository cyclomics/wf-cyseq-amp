params {
    help = false
    input_dir = ""
    read_pattern = "**.{fq,fastq,fq.gz,fastq.gz}"
    stop_pattern = "{seq*,DONE}.txt"
    process_existing_files = true
    include_fastq_fail = false
    out_dir = "output"
    sample_name = ""
    reference_genome = null

    containers {
        alpine = "alpine:3.23.3"
        ubuntu = "ubuntu:25.10"
        cycas = "cyclomics/cycas:0.6.2"
        minimap2 = "staphb/minimap2:2.30"
        samtools = "staphb/samtools:1.23"
    }
}

manifest {
    name = ""
    author = ""
    homePage = ""
    description = ""
    mainScript = "main.nf"
    nextflowVersion = ""
}

executor {
    $local {
        cpus = 4
        memory = "8 GB"
    }
}

labels {
    standard {
        cpus = 2
        memory = "4 GB"
    }
}

profiles {
    standard {
        docker {
            enabled = true
            runOptions = ""
        }
    }
}

timeline {
  enabled = true
  overwrite = true
  file = "${params.out_dir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.out_dir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.out_dir}/execution/trace.txt"
}
cleanup = true

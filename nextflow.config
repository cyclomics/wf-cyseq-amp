params {
    help = false
    sample_name = ""
    input_dir = ""
    reference = ""
    regions = "auto"
    target_depth = null
    output_dir = "output"

    min_raw_length = 500
    split_fastq_by_size = true
    max_fastq_size = 40000
    
    read_pattern = "**.{fq,fastq,fq.gz,fastq.gz}"
    stop_pattern = "{seq*,DONE}.txt"

    process_existing_files = true
    include_fastq_fail = false
    
    cycas_location = '/app/cycas/cycas.py'
    calibration_model = '/app/models/test/fraction'

    containers {
        alpine = "alpine:3.23.3"
        ubuntu = "ubuntu:25.10"
        cycas = "cyclomics/cycas:0.6.2"
        minimap2 = "staphb/minimap2:2.30"
        samtools = "staphb/samtools:1.23"
        seqkit = "staphb/seqkit:2.12.0"
        lofreq = "cyclomics/lofreq:2.1.5"
        alnutils = "cyclomics/aln-utils:0.2.0"
    }

    minimap2 {
        mode = "map-ont"
        min_chain_score =  1
        min_chain_count = 10
        min_peak_aln_score = 20
    }

    roi_detection {
        min_depth = 1000
        max_distance = 25
    }

    report_template = "${projectDir}/assets/report.html"
}

manifest {
    name = ""
    author = ""
    homePage = ""
    description = ""
    mainScript = "main.nf"
    nextflowVersion = ""
}

executor {
    $local {
        cpus = 16
        memory = "30 GB"
    }
}

labels {
    standard {
        cpus = 2
        memory = "4 GB"
    }
}

profiles {
    standard {
        docker {
            enabled = true
            runOptions = ""
        }
    }
    singularity {
        singularity {
            enabled = true
            autoMounts = true
            runOptions = ""
        }
    }
}

timeline {
  enabled = true
  overwrite = true
  file = "${params.output_dir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.output_dir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.output_dir}/execution/trace.txt"
}
cleanup = true
